#version 430 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct Particle {
    vec2 pos;
    vec2 vel;
    vec4 color;
};

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

uniform float uDeltaTime;
uniform vec2 uMousePos; 
uniform float uTime;

void main() {
    uint id = gl_GlobalInvocationID.x;
    
    vec2 pos = particles[id].pos;
    vec2 vel = particles[id].vel;

    vec2 dir = u_MousePos - pos;
    float dist = length(dir);
    
    float strength = 5.0 / (dist + 0.1);
    vec2 force = normalize(dir) * strength;

    vel += force * uDeltaTime;
    
    vel *= 0.98; 

    pos += vel * uDeltaTime;

    if (abs(pos.x) > 1.0) vel.x *= -0.5;
    if (abs(pos.y) > 1.0) vel.y *= -0.5;

    float speed = length(vel);
    vec4 color = vec4(
        0.2 + (speed * 0.1),  // R
        0.5 + (sin(uTime) * 0.2), // G
        0.8 + (speed * 0.2),  // B
        0.8                   // A
    );

    particles[id].pos = pos;
    particles[id].vel = vel;
    particles[id].color = color;
}